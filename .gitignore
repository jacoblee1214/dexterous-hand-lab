# Raw experiment streams and screenshots stay local/artifact-managed. Small
# configurations, summaries, per-condition metrics, and algorithm JSON remain
# eligible for the reproducible research snapshot.
experiments/**/*.jsonl
experiments/**/*.png
experiments/**/*.jpg
experiments/**/*.jpeg
experiments/fusion/reliability_v2_20260909_invalid_v1_visibility_projection/
experiments/grasp_trials/**/summary.json
experiments/grasp_trials/**/trial_*.reconstruction.json
experiments/grasp_trials/**/trial_*.evaluation.json

# Locally retained configuration history. Never delete these as cleanup.
backend/config_backups/
simulation/grasp_backups/
*.bak
*.backup-*

# First private snapshot policy: supplied V6 and legacy CAD/URDF/STL ownership
# is unresolved. Preserve these directories locally but do not upload them.
/assets/V6_Force_R/
/assets/V6_Force_L/
/assets/left_hand/
/assets/meshes/
/assets/urdf/
